
# ====================================================================
# CONFIGURAÇÕES DE BANCO DE DADOS (SUPABASE)
# ====================================================================
# URL do projeto no Supabase (ex: https://xyzcompany.supabase.co)
SUPABASE_URL=

# Chave de serviço (service_role ou anon key) do Supabase
SUPABASE_KEY=

# ====================================================================
# CONFIGURAÇÕES DA META CLOUD API (WHATSAPP)
# ====================================================================
# Token de verificação criado no painel da Meta Developers (para validação do Webhook)
META_VERIFY_TOKEN=

# Token de acesso (Bearer Token) da API do WhatsApp
META_ACCESS_TOKEN=

# ID do número de telefone registrado na Meta Cloud API
META_PHONE_NUMBER_ID=

# Versão da API da Meta (Padrão atual: v19.0)
META_API_VERSION=v19.0

# ====================================================================
# CONFIGURAÇÕES DE WHATSAPP NÃO-OFICIAL (QR CODE - OPCIONAL)
# ====================================================================
# Green API (Serviço Gratuito em Nuvem via QR Code)
GREEN_API_ID=
GREEN_API_TOKEN=

# Evolution API (Self-hosted via QR Code)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
